# These are environment-agnostic placeholders — do not fill in real values
# here. Staging and production must each get their own distinct values,
# set per-environment (Vercel "Preview" for staging, "Production" for
# production) directly in the Vercel dashboard, never committed to this repo.
# See documentation/staging-environment.md for the full setup and the
# naming convention (variable names stay identical across environments;
# only values differ).

# App — base URL, used for OAuth redirects, invite links, email/SMS links
NEXT_PUBLIC_APP_URL= # fill in later

# Supabase (Postgres, Storage, Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Pingram (SMS)
PINGRAM_API_KEY=
PINGRAM_WEBHOOK_SECRET=

# Resend (Email)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Google Calendar (OAuth sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=

#Cloudflare R2 (file storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

#Upstash Redis (BullMQ job queue backing)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (durable job scheduling)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

#Modal (GPU transcription worker)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_WEBHOOK_SECRET=

# Spotify (metadata-only lookup)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
